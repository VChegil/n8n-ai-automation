        "jsonSchemaExample": "{\n  \"score\": 55,\n  \"reasons\": [\"Clear need\", \"Low budget\"],\n  \"red_flags\": [\"No website info\"],\n  \"company_summary\": \"Short description.\",\n  \"email_subject\": \"Re: your automation request\",\n  \"email_body\": \"Hi ...\",\n  \"clarity_score\": 20\n}"
