    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Extract Site Text').item.json;\nconst r = $json;\n\nconst answer = r.answer || '';\nconst snippets = (r.results || [])\n  .slice(0, 5)\n  .map(x => `- ${x.title}: ${x.content}`)\n  .join('\\n');\n\nconst text = [answer, snippets].filter(Boolean).join('\\n\\n').slice(0, 4000);\nconst ok = text.length > 100;\n\nreturn {\n  ...lead,\n  site_title: r.results?.[0]?.title || '',\n  site_description: answer.slice(0, 300),\n  site_text: text,\n  site_ok: ok,\n  info_source: ok ? 'web search' : 'none',\n};"
      },
