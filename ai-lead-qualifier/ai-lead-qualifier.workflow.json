    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Normalize Lead').item.json;\nconst html = String($json.data || '');\n\nconst title = (html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1]?.trim() || '';\nconst description = (html.match(/<meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']*)/i) || [])[1] || '';\n\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;|&amp;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nreturn {\n  ...lead,\n  site_title: title,\n  site_description: description,\n  site_text: text.slice(0, 4000), // trim to save LLM tokens\n  site_ok: text.length > 200,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        112
      ],
      "id": "8beb3ac3-1e66-44a6-a493-ddcc9e75305a",
      "name": "Extract Site Text"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\n\nconst get = (label) =>\n  Object.values(d).find(v => v && v.label === label)?.value ?? '';\n\n// email\nconst email = String(get('Email Address')).trim().toLowerCase();\nconst emailDomain = email.split('@')[1] || '';\nconst freeMail = ['gmail.com','yahoo.com','outlook.com','hotmail.com','icloud.com','seznam.cz','email.cz','ukr.net'];\n\n// website: \"example.com\", \"https://www.example.com/abc\" -> \"example.com\"\nconst rawSite = String(get('Company Website')).trim().toLowerCase();\nconst siteDomain = rawSite\n  .replace(/^https?:\\/\\//, '')\n  .replace(/^www\\./, '')\n  .split('/')[0];\n\n// no website? fall back to email domain (skip free mail providers)\nconst domain = siteDomain || (freeMail.includes(emailDomain) ? '' : emailDomain);\n\n// GDPR: consent checkbox must be true\nconst consent = Object.values(d).some(\n  v => v && String(v.label).startsWith('GDPR') && v.value === true\n);\n\nreturn {\n  run_id: `lead_${Date.now()}_${d.id}`,\n  submission_id: d.id,\n  submitted_at: d.createdAt,\n  name: String(get('Full Name')).trim(),\n  email,\n  company: String(get('Company Name')).trim(),\n  domain,\n  website: domain ? `https://${domain}` : '',\n  needs: String(get('What processes would you like to automate with AI?')).trim(),\n  budget: get('What is your approximate budget?'),\n  timeline: get('What is your project timeline?'),\n  consent,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -816,
        112
      ],
      "id": "fc5fb60e-dcdd-4be3-a677-0966548ccc8c",
