    {
      "parameters": {
        "jsCode": "try {\n  const data = $input.first().json;\n  const transcript = data.transcript || data[0]?.transcript;\n  if (!transcript) throw new Error('no transcript');\n\n  const fullText = transcript.map(t => t.text).join(' ');\n\n  const CHUNK_SIZE = 40000; // ~10k tokens per part\n  const MAX_CHUNKS = 5;     // cap to avoid spam and cost\n\n  const chunks = [];\n  let start = 0;\n  while (start < fullText.length && chunks.length < MAX_CHUNKS) {\n    let end = Math.min(start + CHUNK_SIZE, fullText.length);\n    if (end < fullText.length) {\n      const lastSpace = fullText.lastIndexOf(' ', end);\n      if (lastSpace > start) end = lastSpace;\n    }\n    chunks.push(fullText.slice(start, end).trim());\n    start = end;\n  }\n\n  const truncated = start < fullText.length;\n  const total = chunks.length;\n\n  return chunks.map((text, i) => ({\n    json: { transcript_only_text: text, part: i + 1, total, truncated, error: false },\n    pairedItem: { item: 0 }\n  }));\n} catch (e) {\n  return [{ json: { error: true }, pairedItem: { item: 0 } }];\n}"
      },
