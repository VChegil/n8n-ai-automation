    {
      "parameters": {
        "jsCode": "const data = $('Fetch Transcript').first().json;\nconst segs = data.transcript || data[0]?.transcript || [];\nconst meta = data.metadata || {};\nconst videoId = $('Extract YouTube Video ID').first().json.videoId;\n\nconst TARGET = 900;     // characters per chunk\nconst OVERLAP_SEGS = 2; // transcript lines repeated in the next chunk\n\nconst chunks = [];\nlet cur = [], len = 0;\nfor (let i = 0; i < segs.length; i++) {\n  cur.push(segs[i]);\n  len += segs[i].text.length + 1;\n  if (len >= TARGET || i === segs.length - 1) {\n    chunks.push(cur);\n    cur = cur.slice(-OVERLAP_SEGS);\n    len = cur.reduce((a, s) => a + s.text.length + 1, 0);\n  }\n}\n\nreturn chunks.map((c, i) => {\n  const start = Math.floor(c[0].start);\n  const text = c.map(s => s.text).join(' ').replace(/\\s+/g, ' ').trim();\n  return { json: {\n    text: `Video: ${meta.title || ''} (${meta.author_name || ''})\\n${text}`,\n    video_id: videoId,\n    title: meta.title || '',\n    channel: meta.author_name || '',\n    start,\n    url: `https://youtu.be/${videoId}?t=${start}`,\n    chunk: i + 1,\n    language: data.language || '',\n    run_id: String($execution.id)\n  }};\n});"
      },
